      ],
      "cwd": "${workspaceFolder}/run",
      "env": {},
      "console": "internalConsole",
      "shortenCommandLine": "none"
    },
    {
      "type": "java",
      "request": "launch",
      "name": "Server",
      "presentation": {
        "group": "Mod Development - IndustryBase",
        "order": 3
      },
      "projectName": "IndustryBase",
      "mainClass": "net.neoforged.devlaunch.Main",
      "args": [
        "@${workspaceFolder}/build/moddev/serverRunProgramArgs.txt"
      ],
      "vmArgs": [
