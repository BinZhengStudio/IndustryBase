{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "request": "launch",
      "name": "Client",
      "presentation": {
        "group": "Mod Development - IndustryBase",
        "order": 0
      },
      "projectName": "IndustryBase",
      "mainClass": "net.neoforged.devlaunch.Main",
      "args": [
        "@${workspaceFolder}/build/moddev/clientRunProgramArgs.txt"
      ],
      "vmArgs": [
        "@${workspaceFolder}/build/moddev/clientRunVmArgs.txt",
        "-Dfml.modFolders\u003dindustrybase%%${workspaceFolder}/bin/api:industrybase%%${workspaceFolder}/bin/main",
      ],
      "cwd": "${workspaceFolder}/run",
      "env": {
        // "__NV_PRIME_RENDER_OFFLOAD": "1",
        // "__VK_LAYER_NV_optimus": "NVIDIA_only",
        // "__GLX_VENDOR_LIBRARY_NAME": "nvidia",
        // "__GL_THREADED_OPTIMIZATIONS": "0"
      },
      "console": "internalConsole",
      "shortenCommandLine": "none",
      "linux": {
        "vmArgs": [
          "@${workspaceFolder}/build/moddev/clientRunVmArgs.txt",
          "-Dfml.modFolders\u003dindustrybase%%${workspaceFolder}/bin/api:industrybase%%${workspaceFolder}/bin/main",
          "-Dorg.lwjgl.glfw.libname=/usr/lib/libglfw.so"
        ]
      }
    },
    {
      "type": "java",
      "request": "launch",
      "name": "Data",
      "presentation": {
        "group": "Mod Development - IndustryBase",
        "order": 1
      },
      "projectName": "IndustryBase",
      "mainClass": "net.neoforged.devlaunch.Main",
      "args": [
        "@${workspaceFolder}/build/moddev/dataRunProgramArgs.txt"
      ],
      "vmArgs": [
        "@${workspaceFolder}/build/moddev/dataRunVmArgs.txt",
        "-Dfml.modFolders\u003dindustrybase%%${workspaceFolder}/bin/api:industrybase%%${workspaceFolder}/bin/main"
      ],
      "cwd": "${workspaceFolder}/run",
      "env": {},
      "console": "internalConsole",
      "shortenCommandLine": "none"
    },
    {
      "type": "java",
      "request": "launch",
      "name": "GameTestServer",
      "presentation": {
        "group": "Mod Development - IndustryBase",
        "order": 2
      },
      "projectName": "IndustryBase",
      "mainClass": "net.neoforged.devlaunch.Main",
      "args": [
        "@${workspaceFolder}/build/moddev/gameTestServerRunProgramArgs.txt"
      ],
      "vmArgs": [
        "@${workspaceFolder}/build/moddev/gameTestServerRunVmArgs.txt",
